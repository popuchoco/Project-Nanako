{
  "name": "project-nanako",
  "description": "本機優先的 Windows Electron 檔案空間原型，提供多使用者顯示名稱、桌面視窗操作、檔案傳輸監看與網路診斷；區域網路分享尚未開放。",
  "version": "0.3.0-rc.3",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/run.mjs",
    "desktop": "electron electron/main.mjs",
    "test:media": "electron electron/main.mjs --media-compatibility-test",
    "test:desktop-smoke": "node --test test/desktop-smoke.test.mjs",
    "package:win": "electron-builder --win portable --x64 --publish never",
    "package:win:installer": "electron-builder --win nsis --x64 --publish never",
    "test": "node --expose-gc --test"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "tw.project-nanako.desktop",
    "productName": "Project Nanako",
    "asar": true,
    "electronLanguages": [
      "en-US",
      "zh-TW"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "LICENSE",
      "README.md",
      "THIRD_PARTY.md",
      "docs/**/*",
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/@zip.js/zip.js/dist/**",
      "!node_modules/@zip.js/zip.js/BENCHMARKS.md",
      "!node_modules/@zip.js/zip.js/README.md",
      "!node_modules/@zip.js/zip.js/deno.json",
      "!node_modules/@zip.js/zip.js/eslint.config.mjs",
      "!node_modules/@zip.js/zip.js/release.sh",
      "!node_modules/@zip.js/zip.js/sync-versions.js",
      "!node_modules/@zip.js/zip.js/index.d.ts",
      "!node_modules/@zip.js/zip.js/index.d.cts"
    ],
    "win": {
      "icon": "electron/assets/nanako.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Nanako",
      "installerIcon": "electron/assets/nanako.ico",
      "uninstallerIcon": "electron/assets/nanako.ico",
      "installerLanguages": [
        "en_US",
        "zh_TW"
      ],
      "artifactName": "Nanako-${version}-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "Nanako-${version}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "@zip.js/zip.js": "2.24.0"
  }
}
