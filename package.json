{
  "name": "project-nanako",
  "description": "基於 Windows 的類 sandbox 仿 NAS 專案，以 Electron 延伸打造 Nanako 視窗內的桌面操作體驗與隨選隨用的本機檔案空間。",
  "version": "0.3.0",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/run.mjs",
    "desktop": "electron electron/main.mjs",
    "test:media": "electron electron/main.mjs --media-compatibility-test",
    "package:win": "electron-builder --win portable --x64",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "tw.project-nanako.desktop",
    "productName": "Project Nanako",
    "asar": true,
    "electronLanguages": [
      "en-US",
      "zh-TW"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "LICENSE",
      "README.md",
      "THIRD_PARTY.md",
      "docs/**/*",
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/@zip.js/zip.js/dist/**",
      "!node_modules/@zip.js/zip.js/BENCHMARKS.md",
      "!node_modules/@zip.js/zip.js/README.md",
      "!node_modules/@zip.js/zip.js/deno.json",
      "!node_modules/@zip.js/zip.js/eslint.config.mjs",
      "!node_modules/@zip.js/zip.js/release.sh",
      "!node_modules/@zip.js/zip.js/sync-versions.js",
      "!node_modules/@zip.js/zip.js/index.d.ts",
      "!node_modules/@zip.js/zip.js/index.d.cts"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Nanako-${version}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "@zip.js/zip.js": "2.24.0"
  }
}
